# Reverse-proxy de production — HTTPS automatique (Let's Encrypt).
# Domaines et e-mail ACME lus dans .env : SITE_DOMAIN (Hub), WEBSITE_DOMAIN
# (site public), CMS_DOMAIN (Directus), ACME_EMAIL.
{
	email {$ACME_EMAIL}
}

{$WEBSITE_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy site:3000
}

# Domaine alternatif (ex. .com) — redirection permanente vers le domaine
# principal plutôt que de servir le même contenu sur deux domaines (évite le
# contenu dupliqué en SEO). WEBSITE_DOMAIN_ALT doit toujours avoir une vraie
# valeur dans .env (une adresse de bloc Caddy vide invaliderait tout le
# fichier) — mettre la même valeur que WEBSITE_DOMAIN si aucun second
# domaine n'est réellement possédé.
{$WEBSITE_DOMAIN_ALT} {
	redir https://{$WEBSITE_DOMAIN}{uri} permanent
}

{$CMS_DOMAIN} {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 50MB
	}

	reverse_proxy directus:8055
}

{$SITE_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 50MB
	}

	# API Django + admin + statiques (WhiteNoise) → backend
	@backend path /api/* /django-admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Messagerie Rocket.Chat (uniquement si le profil « chat » tourne)
	handle_path /chat/* {
		reverse_proxy rocketchat:3000
	}

	# Tout le reste → frontend Next.js
	handle {
		reverse_proxy frontend:3000
	}
}
