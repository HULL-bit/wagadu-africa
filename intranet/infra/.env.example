# Copier vers infra/.env et renseigner. NE JAMAIS committer infra/.env.

# ─── Domaines / HTTPS (Caddy) ─────────────────────────────────────────
# Tous doivent pointer (DNS A/AAAA) vers l'IP du VPS avant le premier
# démarrage — Caddy obtient un certificat Let's Encrypt par domaine.
SITE_DOMAIN=intranet.wagadu-africa.org
WEBSITE_DOMAIN=wagadu-africa.org
# Second nom de domaine (ex. .com) — redirigé en 301 vers WEBSITE_DOMAIN.
# Mettre la même valeur que WEBSITE_DOMAIN si un seul domaine est possédé.
WEBSITE_DOMAIN_ALT=wagadu-africa.com
CMS_DOMAIN=cms.wagadu-africa.org
# Portfolio SYSTEM//DIAW (projet indépendant, fichiers statiques hors dépôt).
PORTFOLIO_DOMAIN=souleymane-diaw.online
ACME_EMAIL=admin@example.org

# ─── Django ───────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=wagadu.settings.prod
DJANGO_SECRET_KEY=change-me-generer-50-caracteres-aleatoires
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=intranet.wagadu-africa.org,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://intranet.wagadu-africa.org
DJANGO_TIME_ZONE=Africa/Dakar
DJANGO_LOG_LEVEL=INFO

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=wagadu
POSTGRES_USER=wagadu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Stockage objet — Cloudflare R2 (S3-compatible) ───────────────────
# R2 → Manage R2 API Tokens → créer une clé « Object Read & Write » sur le bucket.
# Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Laisser MINIO_ACCESS_KEY vide → stockage disque local (dev sans R2).
MINIO_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MINIO_BUCKET=wagadu-hub-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=auto
MINIO_USE_SSL=1

# ─── E-mail (SMTP) ────────────────────────────────────────────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=wagadu-hub@example.org

# ─── CORS / Frontend ──────────────────────────────────────────────────
# Même origine que le site (Caddy sert API + front sur le même domaine).
CORS_ALLOWED_ORIGINS=https://intranet.wagadu-africa.org
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ─── Images (déploiement continu depuis GHCR) ─────────────────────────
REGISTRY=ghcr.io/hull-bit
IMAGE_TAG=latest

# ─── Sauvegardes (infra/backup.sh) ───────────────────────────────────
BACKUP_KEEP=14

# ─── Messagerie Rocket.Chat (profil « chat », optionnel) ─────────────
# Vide = messagerie native uniquement. Pour l'activer : renseigner l'URL
# publique + creds, puis `docker compose --profile chat up -d`.
ROCKETCHAT_URL=
ROCKETCHAT_API_URL=http://rocketchat:3000
ROCKETCHAT_HOST_PORT=3100
ROCKETCHAT_ADMIN_USER=wagadu-admin
ROCKETCHAT_ADMIN_PASSWORD=change-me
ROCKETCHAT_ADMIN_EMAIL=chat-admin@example.org

# ─── Visioconférence Jitsi (instance hébergée) ──────────────────────
JITSI_URL=
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=

# ─── Site public Wagadu Africa + Directus (même Postgres, voir postgres-init/) ───
DIRECTUS_DB_NAME=wagadu_cms
DIRECTUS_DB_USER=directus_app
DIRECTUS_DB_PASSWORD=change-me
# KEY/SECRET : deux chaînes aléatoires distinctes, ex. `openssl rand -hex 32`
DIRECTUS_KEY=change-me-openssl-rand-hex-32
DIRECTUS_SECRET=change-me-openssl-rand-hex-32
DIRECTUS_ADMIN_EMAIL=admin@example.org
DIRECTUS_ADMIN_PASSWORD=change-me
NEXT_PUBLIC_SITE_URL=https://wagadu-africa.org
NEXT_PUBLIC_HUB_URL=https://intranet.wagadu-africa.org
NEXT_PUBLIC_DIRECTUS_ADMIN_URL=https://cms.wagadu-africa.org/admin
REVALIDATE_SECRET=change-me
# Jetons de service Directus (create-only sur messages_contact/newsletter_abonnes)
# — générés par `node cms/seed/05-contact-newsletter.mjs` une fois Directus up,
# à coller ici ensuite puis `docker compose restart site`.
DIRECTUS_CONTACT_FORM_TOKEN=
DIRECTUS_NEWSLETTER_TOKEN=
# Slug de campagne Donorbox (donorbox.org/<slug>) — vide = /don affiche le
# contact direct au lieu du widget.
NEXT_PUBLIC_DONORBOX_CAMPAIGN=wagadu
